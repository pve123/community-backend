# 이 파일을 .env로 복사해서 값을 채웁니다. .env는 Git에 올리지 않습니다.
#   cp .env.example .env

# DB (docker-compose의 MySQL과 앱이 같은 값을 씁니다)
DB_URL=jdbc:mysql://localhost:3306/tech_poc
DB_PORT=3306
DB_USERNAME=tech_poc
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379

MAIL_HOST=localhost
MAIL_PORT=1025

# JWT 서명 키 (64바이트 이상 권장). 만드는 법: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# 소셜 로그인을 해 보려면 각 개발자 콘솔에서 발급받아 적습니다. 주석(#)을 풀고 값을 넣습니다. 빈 값으로 두면 앱이 시작되지 않으니 쓰지 않을 때는 주석으로 둡니다.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
